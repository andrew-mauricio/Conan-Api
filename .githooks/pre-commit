#!/bin/sh
# =============================================================================
# HOOK pre-commit -- primeira camada da guarda de documentacao.
#
# PROPOSITO DE NEGOCIO
#   Recusar, na maquina de quem comita, qualquer commit que remova a
#   documentacao publica do projeto. Barato: custa milissegundos e evita que a
#   remocao chegue a ser gravada.
#
# INVARIANTES DO DOMINIO
#   Estado 2 da guarda (NAO VERIFICOU) bloqueia o commit exatamente como o
#   estado 1. Deixar passar o que nao foi medido e o defeito de origem.
#
# COMPORTAMENTO EM CASO DE FALHA
#   Sai != 0 e o git aborta o commit, imprimindo o caminho ausente. O operador
#   tem duas saidas legitimas: corrigir, ou 'git commit --no-verify' quando a
#   remocao for deliberada.
# =============================================================================

RAIZ=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$RAIZ" ]; then
    echo "pre-commit: NAO VERIFICOU -- nao achei a raiz do repositorio" >&2
    exit 1
fi

sh "$RAIZ/.githooks/verificar-documentacao.sh"
estado=$?

[ "$estado" -eq 0 ] && exit 0

echo "" >&2
echo "COMMIT RECUSADO pela guarda de documentacao (estado $estado)." >&2
exit 1
